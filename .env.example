DATABASE_URL=postgresql://chat_user:chat_password@db:5432/chat_app
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=50
DB_POOL_TIMEOUT_SECONDS=60

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CONTAINER_PORT=8000

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_CONTAINER_PORT=5173
FRONTEND_URL=http://localhost:3000

VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

JWT_SECRET=tsmc_messenger_jwt_secret_key_2024_very_secure
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

KAFKA_CLUSTER_ID=chatweb-kraft-cluster-001
KAFKA_BROKER_ID=0
KAFKA_INTERNAL_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_EXTERNAL_PORT=9094
KAFKA_ADVERTISED_HOST=localhost
KAFKA_UI_PORT=8081
KAFKA_TOPIC_CHAT_EVENTS=chat.events
KAFKA_TOPIC_PARTITIONS=12
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TEST_DURATION_SECONDS=900
KAFKA_TARGET_MSG_RATE=1000
KAFKA_TARGET_ONLINE_USERS=100000
KAFKA_MESSAGE_FLOW_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8088
BACKEND_METRICS_TARGET=chat_backend:8000
